{
  "name": "eien",
  "displayName": "Eien - Keep Copilot Chat Running",
  "description": "Resume stalled Copilot Chat work overnight, save Git checkpoints, and generate a morning report.",
  "publisher": "ShunsukeF",
  "license": "MIT",
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/furukawa658/vscode-chat-tools"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "copilot",
    "copilot-chat",
    "ai",
    "automation",
    "productivity",
    "night",
    "checkpoint",
    "git"
  ],
  "version": "0.2.2",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "properties": {
        "eien.maxHours": {
          "description": "Maximum number of hours Eien may run.",
          "default": 8,
          "type": "number"
        },
        "eien.idleSeconds": {
          "description": "Seconds without a chat-file update before a stall is considered.",
          "default": 120,
          "type": "number"
        },
        "eien.maxInterventions": {
          "description": "Maximum number of resume prompts Eien may send.",
          "default": 20,
          "type": "number"
        },
        "eien.autoClickApprovals": {
          "description": "Use the operating system accessibility API to click a known chat approval button. Falls back to a continuation prompt when unavailable.",
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Eien"
    },
    "commands": [
      {
        "command": "eien.start",
        "title": "Eien: Start Overnight Monitoring"
      },
      {
        "command": "eien.stop",
        "title": "Eien: Stop Overnight Monitoring"
      },
      {
        "command": "eien.report",
        "title": "Eien: Open Morning Report"
      }
    ]
  },
  "icon": "icon.png"
}
